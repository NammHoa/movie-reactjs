PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/movie-booking
CLIENT_URL=http://localhost:5173

# Khóa ký đăng nhập: phải là chuỗi ngẫu nhiên dài, KHÔNG dùng lại giá trị mẫu này (ai cũng thấy nó trên GitHub).
# Tạo khóa mới:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_thanh_chuoi_bi_mat_cua_ban

# Tùy chọn
# HOLD_MINUTES=10          số phút giữ ghế chờ thanh toán
# RATE_LIMIT_OFF=true      tắt giới hạn request khi dev (bị bỏ qua ở production)
# TRUST_PROXY=1            số proxy đứng trước server khi deploy (Render, Nginx...)
# PAYMENT_GATEWAY=mock     mock = cổng giả lập, chỉ chạy khi không phải production
# EMAIL_PROVIDER=console   gửi vé qua email: console = chỉ ghi log (dev), brevo = gửi thật. Bỏ trống = không gửi
# BREVO_API_KEY=           khóa API của Brevo (Brevo > SMTP & API > API Keys), không đưa lên GitHub
# MAIL_FROM_EMAIL=         email người gửi, PHẢI đã xác minh trong Brevo (Settings > Senders)
# MAIL_FROM_NAME=MovieBooking
# ALLOW_MOCK_PAYMENT=true  bật cổng giả lập cả ở production: CHỈ cho bản demo, ai cũng "thanh toán" được mà không mất tiền
# REFUND_CUTOFF_HOURS=2     khách tự hủy vé và nhận hoàn tiền được đến trước giờ chiếu bao nhiêu giờ (admin không bị giới hạn)
# VNPAY_REFUND_URL=       địa chỉ API hoàn tiền của VNPay; bỏ trống = sandbox (https://sandbox.vnpayment.vn/merchant_webapi/api/transaction)
